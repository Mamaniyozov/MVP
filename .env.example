# Django
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change-this-to-a-random-secret-key-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2,yourdomain.com

# Database
POSTGRES_DB=finance_db
POSTGRES_USER=finance_user
# IMPORTANT: In production, do not hardcode passwords here. Use Docker Secrets or a secrets manager.
POSTGRES_PASSWORD=generate-a-secure-random-password-here
# Host'da manage.py ishlatilganda localhost (compose 5432 portni publish qiladi).
# docker-compose.yml backend konteyneriga DB_HOST=db ni o'zi beradi (environment > env_file).
DB_HOST=localhost
DB_PORT=5432

# CORS (Production + Local dev)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://10.0.2.2:8000,https://yourdomain.com
CSRF_TRUSTED_ORIGINS=http://localhost:3000,https://yourdomain.com
